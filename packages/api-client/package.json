{
  "name": "@alp/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript API client for ALP. Types generated from openapi/phase1.yaml; runtime wrapper adds auth + retries + tracing.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "generate": "openapi-typescript ../../openapi/phase1.yaml -o src/types.generated.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "format": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "openapi-typescript": "^7.4.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
