{
  "name": "@alp/design-system",
  "version": "0.1.0",
  "private": true,
  "description": "ALP shared design tokens + primitive components. See docs/01_design/07_CommonControls_Specification_AdaptiveLearningPlatform.md.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js"
    },
    "./tokens.css": "./src/tokens.css",
    "./tokens.v2.css": "./src/tokens.v2.css",
    "./density.css": "./src/density.css",
    "./shell.css": "./src/shell.css",
    "./portals/admin.css": "./src/portals/admin.css",
    "./portals/teacher.css": "./src/portals/teacher.css",
    "./portals/author.css": "./src/portals/author.css",
    "./portals/mobile.css": "./src/portals/mobile.css"
  },
  "files": [
    "dist",
    "src/tokens.css",
    "src/tokens.v2.css",
    "src/density.css",
    "src/shell.css",
    "src/portals/*.css",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --passWithNoTests",
    "format": "prettier --check ."
  },
  "peerDependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
