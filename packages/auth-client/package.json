{
  "name": "@alp/auth-client",
  "version": "0.1.0",
  "private": true,
  "description": "Shared JWT + refresh + SSO flow for the three ALP web apps. Web-only — mobile (Flutter) has its own equivalent.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "format": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
