<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- LaunchTheme — applied while the process starts; replaced by the
         Flutter UI as soon as the first frame paints.

         Aurora v3 / Wave 1: parent flipped from Theme.Light.NoTitleBar to
         Theme.Black.NoTitleBar so the native splash, the Flutter _Splash
         widget, and the dark-locked Aurora theme all share the same
         appearance — no white flash, no status-bar mismatch. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- NormalTheme — applied behind the running Flutter UI. Set to dark
         so any sliver beyond Flutter's render bounds (gesture-bar zone,
         predictive-back overflow) also reads as Aurora. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/aurora_splash_bg</item>
    </style>
</resources>
