<?xml version="1.0" encoding="utf-8"?>
<!-- Aurora v3 — night-mode native splash. Identical to values/styles.xml
     because the Flutter app is locked to dark until Wave 2 ships the light
     widget library. When light mode returns, this file diverges. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/aurora_splash_bg</item>
    </style>
</resources>
