# Adaptive Learning Platform — local dev environment
# Copy to .env (NOT checked in). Each service reads its own AUTH_*, CATALOG_*, etc. prefix.

# Global
ENVIRONMENT=local
LOG_LEVEL=INFO

# Postgres (shared instance in local Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# NATS JetStream
NATS_URL=nats://localhost:4222

# OpenSearch
OPENSEARCH_URL=http://localhost:9200

# LocalStack (AWS emulation)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=ap-south-1
AWS_ENDPOINT_URL=http://localhost:4566

# Mailpit (local email)
SMTP_HOST=localhost
SMTP_PORT=1025

# Service ports (host-mode during dev)
AUTH_PORT=8001
USER_PROFILE_PORT=8002
CONTENT_PORT=8003
CATALOG_PORT=8004
SEARCH_PORT=8005
ANALYTICS_PORT=8006
PAYMENT_PORT=8007
INSTITUTION_PORT=8008
NOTIFICATION_PORT=8009
ADAPTIVE_ENGINE_PORT=8010
ADAPTIVE_ENGINE_GRPC_PORT=50051
QUIZ_PORT=8011
