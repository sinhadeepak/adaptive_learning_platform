# Adaptive Learning Platform — local dev environment
# Copy to .env (NOT checked in). Each service reads its own AUTH_*, CATALOG_*, etc. prefix.
#
# Port convention: every host-bound port is the canonical port + 30000.
# Pattern: prefix `3` + the standard port (e.g. 5432 → 35432, 8001 → 38001).
# This keeps host ports out of the most-trodden 1024–9999 range so collisions
# with other tools (system Postgres, native Redis, dev servers) are rare.
# In-container ports stay standard — only the host-side mapping is shifted.

# Global
ENVIRONMENT=local
LOG_LEVEL=INFO

# Postgres (shared instance in local Docker Compose; one DB per service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=35432

# Per-service DATABASE_URL — read by Alembic env.py and the service's runtime engine.
# Pattern: postgresql+asyncpg://<user>:<pass>@<host>:<port>/<db_name>
# DB names match infrastructure/docker/docker-compose.yml POSTGRES_MULTIPLE_DATABASES.
AUTH_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:35432/auth
USER_PROFILE_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:35432/user_profile
CONTENT_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:35432/content
CATALOG_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:35432/catalog
SEARCH_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:35432/search
ANALYTICS_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:35432/analytics
PAYMENT_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:35432/payment
INSTITUTION_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:35432/institution
NOTIFICATION_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:35432/notification
ADAPTIVE_ENGINE_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:35432/adaptive_engine
QUIZ_DATABASE_URL=postgres://postgres:postgres@localhost:35432/quiz?sslmode=disable

# Redis
REDIS_URL=redis://localhost:36379/0

# NATS JetStream
NATS_URL=nats://localhost:34222
NATS_MONITOR_URL=http://localhost:38222

# OpenSearch
OPENSEARCH_URL=http://localhost:39200

# LocalStack (AWS emulation)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=ap-south-1
AWS_ENDPOINT_URL=http://localhost:34566

# Mailpit (local email)
SMTP_HOST=localhost
SMTP_PORT=31025
MAILPIT_UI_URL=http://localhost:38025

# Service ports (host-mode during dev — services run on host, not in containers)
AUTH_PORT=38001
USER_PROFILE_PORT=38002
CONTENT_PORT=38003
CATALOG_PORT=38004
SEARCH_PORT=38005
ANALYTICS_PORT=38006
PAYMENT_PORT=38007
INSTITUTION_PORT=38008
NOTIFICATION_PORT=38009
ADAPTIVE_ENGINE_PORT=38010
ADAPTIVE_ENGINE_GRPC_PORT=50051
QUIZ_PORT=38011
QUIZ_NATS_URL=nats://localhost:34222
QUIZ_INSTITUTION_BASE_URL=http://localhost:38008
QUIZ_SESSION_TTL_MIN=90
